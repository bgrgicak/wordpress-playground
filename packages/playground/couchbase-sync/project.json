{
	"name": "playground-couchbase-sync",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/playground/couchbase-sync/src",
	"projectType": "lib",
	"tags": ["scope:web-client"],
	"targets": {
		"build": {
			"executor": "nx:noop",
			"dependsOn": ["build:vite"]
		},
		"build:vite": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/packages/playground/couchbase-sync"
			},
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"mode": "production"
				}
			},
			"dependsOn": ["^build"]
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": [
				"{workspaceRoot}/coverage/packages/playground/couchbase-sync"
			],
			"options": {
				"passWithNoTests": true,
				"reportsDirectory": "../../../coverage/packages/playground/couchbase-sync"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"useFlatConfig": false,
				"lintFilePatterns": [
					"packages/playground/couchbase-sync/**/*.{ts,tsx,js,jsx}"
				],
				"maxWarnings": 0
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"tsc -p packages/playground/couchbase-sync/tsconfig.app.json --noEmit"
				]
			}
		}
	}
}
